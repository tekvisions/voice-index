{
  "host": "voice.kymatalabs.com",
  "reviewed_on": "2026-11-03",
  "title": "Choose voice AI tools for synthesis, recognition or realtime use",
  "answer": "First separate text-to-speech, speech-to-text and an interactive voice pipeline. A library that synthesizes speech, a runtime that supports several speech tasks and an application that calls those libraries need different evaluation questions.",
  "choices": [
    {
      "categories": [
        "Text-to-Speech"
      ],
      "task": "Generate speech from text",
      "guidance": "Check the specific voice/model, language, license, runtime version and target hardware. A runtime name alone is not a reproducible voice-quality or speed result."
    },
    {
      "categories": [
        "Speech-to-Text",
        "Enhancement & Analysis"
      ],
      "task": "Transcribe or clean recorded audio",
      "guidance": "Use audio representative of your speakers, noise, accents and recording setup. Define whether transcription errors, timestamps, diarization or enhancement quality matter for the task."
    },
    {
      "categories": [
        "Voice Agents & Realtime",
        "Toolkits & Frameworks"
      ],
      "task": "Build a live conversation",
      "guidance": "Evaluate capture, voice activity detection, recognition, model response and synthesis as a complete pipeline. Measure interruption behavior and time to first audible output on the intended device."
    }
  ],
  "checks": [
    "Record runtime and model versions, voice/language, CPU model, thread count, precision and sample rate.",
    "Check runtime and model/voice licenses independently, and verify whether the configured path is local or uses external services.",
    "Treat upstream performance statements as claims tied to their stated environment until reproduced."
  ],
  "unknowns": "This index has not run a matched Piper/MeloTTS/sherpa-onnx CPU benchmark, listening test or recognition evaluation. Availability of a repository is not proof of suitability for a particular speaker or device.",
