    }
  ],
  "comparison": {
    "title": "Piper vs MeloTTS vs sherpa-onnx on CPU",
    "answer": "No verified comparable winner is established here. Compare the specific synthesis models and voices on the same machine; a runtime name or an upstream realtime claim does not determine the result.",
    "protocol": [
      "Fix the CPU, operating system, thread count, runtime/model revisions, precision, voice/language and sample rate.",
      "Use the same representative text set. Record cold initialization separately from warmed synthesis, time to first audio, total synthesis time and peak memory.",
      "Report real-time factor as synthesis wall-clock seconds divided by generated audio seconds, with the raw timings and output durations. Keep quality/listening checks alongside speed results.",
      "Publish failures, settings and limitations. Mark untested hardware, languages and voices unknown; do not extrapolate a universal fastest engine."
    ]
  },
  "scope_notes": [
    {
      "entity": "harry0703/MoneyPrinterTurbo",
      "note": "A video-production workflow with voiceover and optional Whisper subtitle transcription, retained as an integration reference. The primary documentation describes video creation and an optional upstream Whisper transcription integration. It does not support presenting this application as the leading core Speech-to-Text implementation. Core spoken-language-stack inclusion is withheld pending review.",
      "source": "https://github.com/harry0703/MoneyPrinterTurbo/blob/main/README-en.md"
    }
  ]
